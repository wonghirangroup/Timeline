# server/.env.vps.example — copy เป็น .env บน VPS ข้าง docker-compose.yml (ห้าม commit ตัวจริง)
# ค่าจริงเอามาจาก Render dashboard (Environment tab ของ timeline-api) — คัดลอกมาตรงๆ ได้เลย
# เพราะเป็น secret ชุดเดียวกัน ต่อ DB เดียวกัน (152.42.227.103)

DATABASE_URL=mysql://root:xxxxx@152.42.227.103:3306/checkchue?connection_limit=5&pool_timeout=10
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d
ENCRYPTION_KEY=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=

# Cloudinary — ภาพ Loading หน้าเข้าสู่ระบบต่อ tenant (account เดียวกับ linecommerce-pro)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# โดเมน/URL ของ frontend ที่อนุญาตให้เรียก API นี้ (คั่นด้วย comma ถ้ามีหลายอัน)
CORS_ADMIN_URL=https://timeline-admin.vercel.app
CORS_SUPERADMIN_URL=https://timeline-superadmin.vercel.app
CORS_EMPLOYEE_URL=https://timeline-employee.vercel.app
