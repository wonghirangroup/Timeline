// server/src/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────

model Tenant {
  id            String      @id @default(uuid())
  name          String
  plan          TenantPlan  @default(FREE)
  max_employees Int         @default(5)
  max_branches  Int         @default(1)
  is_active     Boolean     @default(true)
  loading_image_url String? // ภาพ Loading หน้าเข้าสู่ระบบ LIFF ของ tenant นี้ (Cloudinary) — null = ใช้ default mascot
  enabled_features   Json?  // Record<FeatureKey, boolean> — key ที่ไม่มี/เป็น null = เปิดใช้งาน (default backward-compatible)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  deleted_at    DateTime?

  line_config   TenantLineConfig?
  users         User[]
  employees     Employee[]
  branches      Branch[]
  shifts        Shift[]
  holidays      Holiday[]
  announcements Announcement[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum GeoMode {
  WARN   // เช็คอินได้แต่ flag is_outside_area
  BLOCK  // บล็อค — ต้องสแกน QR ในพื้นที่เท่านั้น
}

model TenantLineConfig {
  id                  String   @id @default(uuid())
  tenant_id           String   @unique
  line_channel_id           String
  line_channel_secret       String
  line_channel_access_token String?
  line_liff_id              String
  rich_menu_id        String?
  logo_url            String?  // white-label
  primary_color       String?  // white-label
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("tenant_line_configs")
}

// ─────────────────────────────────────────────
// USERS (Web App login: SUPER_ADMIN / ADMIN / MANAGER)
// ─────────────────────────────────────────────

model User {
  id         String    @id @default(uuid())
  tenant_id  String?   // null = SUPER_ADMIN
  email      String    @unique
  password   String    // bcrypt hashed
  first_name String
  last_name  String
  role       UserRole
  is_active  Boolean   @default(true)
  must_change_password Boolean @default(false)  // ตั้ง true ตอน Talent (SUPER_ADMIN) สร้าง Admin ให้ — ยังไม่ enforce ตอน login (รอ phase ถัดไป)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant           Tenant?         @relation(fields: [tenant_id], references: [id])
  managed_branches BranchManager[]

  @@index([tenant_id])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

// ─────────────────────────────────────────────
// EMPLOYEE (Line LIFF login)
// ─────────────────────────────────────────────

model Employee {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  employee_code String
  first_name    String
  last_name     String
  nickname      String?
  department    String?
  phone         String?
  hired_at      DateTime? @db.Date
  line_user_id  String?   // mapped after Line verify
  is_active     Boolean   @default(true)  // derived จาก status — status=ACTIVE เท่านั้นที่ is_active=true (คง field นี้ไว้เพราะมีที่เช็คตรงๆ อยู่หลายจุด เช่น LIFF login gate)
  status        EmployeeStatus @default(ACTIVE)
  status_reason String?   // เหตุผลล่าสุด (ประวัติเต็มอยู่ใน EmployeeStatusLog)
  weekly_off_mode WeeklyOffMode @default(WEEKLY)  // WEEKLY = จองทีละสัปดาห์ (เดิม), MONTHLY_BATCH = ต้องจองครบทุกสัปดาห์ในเดือนรวดเดียว
  default_shift_id String? // กะที่สังกัด — informational เท่านั้น ไม่ได้บังคับตอนเช็คอิน (auto-detect จากเวลาเหมือนเดิม)
  pending_fine  Decimal   @default(0) @db.Decimal(8, 2)  // ค่าปรับขาดที่ยังไม่ได้หัก — จะถูกยกไปรวมกับ fine ของ attendance record ถัดไปแล้วรีเซ็ตเป็น 0
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  tenant              Tenant              @relation(fields: [tenant_id], references: [id])
  branch              Branch              @relation(fields: [branch_id], references: [id])
  default_shift       Shift?              @relation("EmployeeDefaultShift", fields: [default_shift_id], references: [id], onDelete: SetNull)
  attendance_records  AttendanceRecord[]
  leave_requests      LeaveRequest[]
  leave_balances      LeaveBalance[]
  ot_requests         OtRequest[]
  weekly_off_requests WeeklyOffRequest[]
  status_logs         EmployeeStatusLog[]
  shift_assignments   ShiftAssignment[]

  @@unique([tenant_id, employee_code])
  @@unique([tenant_id, line_user_id])
  @@index([tenant_id])
  @@index([branch_id])
  @@index([default_shift_id])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE      // ใช้งาน
  INACTIVE    // ไม่ใช้งาน
  RESIGNED    // ลาออก
  TERMINATED  // เลิกจ้าง
}

model EmployeeStatusLog {
  id          String          @id @default(uuid())
  tenant_id   String
  employee_id String
  from_status EmployeeStatus?
  to_status   EmployeeStatus
  reason      String
  changed_by  String?         // user_id ของ admin ที่เปลี่ยน
  created_at  DateTime        @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([tenant_id])
  @@index([employee_id])
  @@map("employee_status_logs")
}

// ─────────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────────

model Branch {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  location   String?
  lat        Decimal?  @db.Decimal(10, 8)
  lng        Decimal?  @db.Decimal(11, 8)
  gps_radius Int       @default(200)   // รัศมียอมรับ (เมตร)
  geo_mode   GeoMode   @default(WARN)  // WARN=แจ้งเตือน, BLOCK=บล็อค
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant          Tenant             @relation(fields: [tenant_id], references: [id])
  employees       Employee[]
  shifts          Shift[]
  managers        BranchManager[]
  weekly_off_periods WeeklyOffPeriod[]

  @@index([tenant_id])
  @@map("branches")
}

model BranchManager {
  id        String @id @default(uuid())
  branch_id String
  user_id   String

  branch Branch @relation(fields: [branch_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([branch_id, user_id])
  @@map("branch_managers")
}

// ─────────────────────────────────────────────
// SHIFT
// ─────────────────────────────────────────────

model Shift {
  id              String    @id @default(uuid())
  tenant_id       String
  branch_id       String
  name            String
  start_time       String    // "08:00"
  end_time         String    // "17:00"
  min_checkout     String?   // "17:55" — เช็คเอาท์ได้ตั้งแต่เวลานี้
  late_threshold   Int       @default(15) // minutes — เก็บไว้ backward compat
  late_threshold_1 String?   // "08:05" — สายระดับ 1
  late_threshold_2 String?   // "08:30" — สายระดับ 2
  late_fine_1      Decimal?  @db.Decimal(8, 2)  // ค่าปรับสายระดับ 1 (บาท)
  late_fine_2      Decimal?  @db.Decimal(8, 2)  // ค่าปรับสายระดับ 2 (บาท)
  absent_threshold String?   // "08:31" — เช็คอินหลังเวลานี้ = นับว่าขาด (ยังเช็คอินได้ปกติ)
  absent_fine      Decimal?  @db.Decimal(8, 2)  // ค่าปรับที่จะถูกหักในวันที่มาเช็คอินถัดไป
  shift_type       ShiftType @default(REGULAR)
  gps_radius       Int?      // รัศมีเช็คอิน (เมตร) — null = ใช้ค่าของสาขา
  allow_overlap    Boolean   @default(false)
  day_off_quota   Int       @default(1)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  tenant             Tenant             @relation(fields: [tenant_id], references: [id])
  branch             Branch             @relation(fields: [branch_id], references: [id])
  attendance_records AttendanceRecord[]
  default_employees  Employee[]         @relation("EmployeeDefaultShift")
  shift_assignments  ShiftAssignment[]

  @@index([tenant_id])
  @@index([branch_id])
  @@map("shifts")
}

// ─────────────────────────────────────────────
// SHIFT ASSIGNMENT (ตารางกะ — override รายวันของแอดมิน)
// ─────────────────────────────────────────────

enum ShiftAssignmentType {
  WORK        // ทำงาน (ผูกกับ shift_id)
  DAY_OFF     // หยุดพัก (manual correction — ไม่ใช่ WEEKLY_OFF/LEAVE ที่มาจากระบบจริง)
  WEEKLY_OFF  // หยุดประจำสัปดาห์ (manual override — ปกติมาจาก WeeklyOffRequest)
  HOLIDAY     // หยุดนักขัตฤกษ์ (manual override — ปกติมาจาก Holiday)
}

model ShiftAssignment {
  id          String              @id @default(uuid())
  tenant_id   String
  employee_id String
  date        DateTime            @db.Date
  shift_id    String?             // null เมื่อ type != WORK
  type        ShiftAssignmentType @default(WORK)
  note        String?
  created_by  String?             // user_id ของ admin ที่แก้
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])
  shift    Shift?   @relation(fields: [shift_id], references: [id], onDelete: SetNull)

  @@unique([employee_id, date])
  @@index([tenant_id])
  @@map("shift_assignments")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model AttendanceRecord {
  id               String              @id @default(uuid())
  tenant_id        String
  employee_id      String
  shift_id         String
  date             DateTime            @db.Date
  check_in_at      DateTime?
  check_out_at     DateTime?
  check_in_method  CheckInMethod       @default(LIFF)
  is_late          Boolean             @default(false)
  late_minutes     Int                 @default(0)
  is_absent        Boolean             @default(false)   // สายเกิน absent_threshold ของกะ — ยังเช็คอินได้ แต่นับเป็นขาด
  fine             Decimal             @default(0) @db.Decimal(8, 2)  // ค่าปรับของวันนี้เอง (สายระดับ 1/2 ตาม tier ปัจจุบัน) — ไม่รวม carried_fine
  carried_fine     Decimal             @default(0) @db.Decimal(8, 2)  // ค่าปรับขาดที่ยกมาจากวันก่อนหน้า (ตั้งครั้งเดียวตอนสร้าง record ไม่เปลี่ยนตอนแก้ไขเวลาเช็คอินภายหลัง)
  gps_lat          Decimal?            @db.Decimal(10, 8)
  gps_lng          Decimal?            @db.Decimal(11, 8)
  is_outside_area  Boolean             @default(false)   // true = เช็คอินนอกรัศมี (WARN mode)
  is_outside_shift Boolean             @default(false)   // true = สแกน QR นอกช่วงเวลากะ
  attachment_url   String?             // Phase 4: selfie fallback
  note             String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])
  shift    Shift    @relation(fields: [shift_id], references: [id])

  @@unique([employee_id, shift_id, date])
  @@index([tenant_id])
  @@index([employee_id])
  @@map("attendance_records")
}

enum ShiftType {
  REGULAR  // กะทั่วไป auto-detect จากเวลา
  SPECIAL  // กะพิเศษ เงื่อนไขเฉพาะ
  OFFSITE  // งานนอกสถานที่ / Sale / Event — ไม่ check GPS แต่บันทึกพิกัด
}

enum CheckInMethod {
  LIFF          // ปกติผ่าน LIFF
  QR            // สแกน QR ที่สาขา (BLOCK mode)
  ADMIN         // Admin ลงให้ด้วยตนเอง
  WEB_FALLBACK  // Phase 4: Line ล่ม fallback
  SELFIE        // Phase 4: offline selfie
  OFFSITE       // Phase 4: GPS off-site
}

// ─────────────────────────────────────────────
// LEAVE
// ─────────────────────────────────────────────

model LeaveRequest {
  id             String      @id @default(uuid())
  tenant_id      String
  employee_id    String
  leave_type     LeaveType
  start_date     DateTime    @db.Date
  end_date       DateTime    @db.Date
  days           Int
  reason         String?
  attachment_url String?     // ใบรับรองแพทย์
  status         LeaveStatus @default(PENDING)
  reviewed_by    String?     // user_id
  reviewed_at    DateTime?
  reject_note    String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([tenant_id])
  @@index([employee_id])
  @@map("leave_requests")
}

enum LeaveType {
  SICK
  PERSONAL
  VACATION
  MATERNITY
  COMPENSATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeeklyOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveBalance {
  id          String    @id @default(uuid())
  tenant_id   String
  employee_id String
  leave_type  LeaveType
  year        Int
  total_days  Int
  used_days   Int       @default(0)
  updated_at  DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, leave_type, year])
  @@index([tenant_id])
  @@map("leave_balances")
}

// ─────────────────────────────────────────────
// OT (Phase 2)
// ─────────────────────────────────────────────

model OtRequest {
  id          String    @id @default(uuid())
  tenant_id   String
  employee_id String
  date        DateTime  @db.Date
  start_time  String    // "18:00"
  end_time    String    // "21:00"
  hours       Decimal   @db.Decimal(4, 2)
  reason      String?
  status      LeaveStatus @default(PENDING)
  reviewed_by String?
  reviewed_at DateTime?
  reject_note String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([tenant_id])
  @@index([employee_id])
  @@map("ot_requests")
}

// ─────────────────────────────────────────────
// WEEKLY OFF REQUEST
// ─────────────────────────────────────────────

enum WeeklyOffMode {
  WEEKLY         // จองทีละสัปดาห์ (เดิม) — ใช้ POST /employee/weekly-off
  MONTHLY_BATCH  // ต้องจองครบทุกสัปดาห์ในเดือนรวดเดียว — ใช้ POST /employee/weekly-off/monthly-batch
}

model WeeklyOffRequest {
  id          String          @id @default(uuid())
  tenant_id   String
  employee_id String
  week_start  DateTime        @db.Date           // วันจันทร์ของสัปดาห์นั้น
  day_of_week Int                                // 0=อา 1=จ 2=อ 3=พ 4=พฤ 5=ศ 6=ส
  status      WeeklyOffStatus @default(PENDING)
  reviewed_by String?                            // user_id ของ admin/manager
  reviewed_at DateTime?
  reject_note String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, week_start])            // 1 คน = 1 วันหยุดต่อสัปดาห์
  @@index([tenant_id])
  @@index([employee_id])
  @@map("weekly_off_requests")
}

// ─────────────────────────────────────────────
// WEEKLY OFF PERIOD (เปิด/ปิดการจองต่อสาขาต่อเดือน)
// ─────────────────────────────────────────────

model WeeklyOffPeriod {
  id         String    @id @default(uuid())
  tenant_id  String
  branch_id  String
  month      String                    // YYYY-MM
  is_open    Boolean   @default(true)
  deadline   DateTime?                 // null = ไม่มี deadline
  note       String?                   // หมายเหตุถึงพนักงาน
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  branch Branch @relation(fields: [branch_id], references: [id])

  @@unique([tenant_id, branch_id, month])
  @@index([tenant_id])
  @@map("weekly_off_periods")
}

// ─────────────────────────────────────────────
// HOLIDAY
// ─────────────────────────────────────────────

model Holiday {
  id                 String      @id @default(uuid())
  tenant_id          String
  name               String
  date               DateTime    @db.Date
  type               HolidayType @default(NATIONAL)
  recurring          Boolean     @default(false)
  target_branches    Json?       // string[] ของ branch_id — null/[] = ทุกสาขา
  target_departments Json?       // string[] ของรหัสแผนก 2 ตัวแรก (เช่น "03") — null/[] = ทุกแผนก
  created_at         DateTime    @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("holidays")
}

enum HolidayType {
  NATIONAL   // นักขัตฤกษ์
  RELIGIOUS  // ศาสนา
  COMPANY    // บริษัท
}

// ─────────────────────────────────────────────
// ANNOUNCEMENT (Phase 2)
// ─────────────────────────────────────────────

model Announcement {
  id          String   @id @default(uuid())
  tenant_id   String
  title       String
  content     String   @db.Text
  send_line   Boolean  @default(false) // broadcast ผ่าน Line ด้วย
  created_by  String   // user_id
  created_at  DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("announcements")
}
